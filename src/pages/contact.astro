---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadProfile } from '../lib/profile';
const profile = loadProfile();
---
<BaseLayout
  title={`Contact · ${profile.name}`}
  description="ส่งรายละเอียดงานหรือคำถามผ่านฟอร์มนี้"
>
  <section class="card">
    <h1>Contact</h1>
    <p>เล่าคร่าว ๆ ว่าเป็นงานแบบไหนและอยากได้ผลลัพธ์อะไร แล้วจะติดต่อกลับทางอีเมลที่ให้ไว้</p>
    <form id="contact-form">
      <label for="name">ชื่อ</label>
      <input id="name" name="name" required maxlength="80" autocomplete="name" />
      <label for="email">อีเมล</label>
      <input id="email" name="email" type="email" required maxlength="120" autocomplete="email" />
      <label for="message">รายละเอียด</label>
      <textarea id="message" name="message" rows="5" required maxlength="2000"></textarea>
      <p style="margin-top:1rem"><button type="submit">ส่งข้อความ</button></p>
      <p id="status" role="status" aria-live="polite"></p>
    </form>
  </section>
</BaseLayout>
<script>
  const form = document.getElementById('contact-form');
  const status = document.getElementById('status');

  // Never surface the API's own error text: it can carry internal wording and
  // means nothing to a visitor (D7). Map the status code to plain Thai (D8).
  function messageFor(code) {
    if (code === 501) return 'ฟอร์มยังไม่เปิดใช้งาน';
    if (code === 400) return 'กรอกข้อมูลไม่ครบ ลองตรวจอีกครั้ง';
    return 'ส่งไม่สำเร็จ ลองใหม่อีกครั้ง';
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const payload = Object.fromEntries(new FormData(form).entries());
    status.textContent = 'กำลังส่ง…';
    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(payload),
      });
      if (res.ok) {
        status.textContent = 'ส่งเรียบร้อย ขอบคุณที่ติดต่อมา';
        form.reset();
      } else {
        status.textContent = messageFor(res.status);
      }
    } catch (err) {
      status.textContent = 'เชื่อมต่อไม่ได้ ลองใหม่อีกครั้ง';
    }
  });
</script>
