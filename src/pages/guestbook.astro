---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
/**
 * Closed in v1 by decision D5, and deliberately inert.
 *
 * The earlier version built entries with innerHTML from names and messages
 * supplied by visitors (D6) — a stored XSS the moment the API starts
 * returning rows. Rather than patch the escaping on a feature nobody asked
 * for yet, the page keeps no form and makes no request at all. It stays
 * reachable so existing links do not 404, and it is not in the nav.
 *
 * Reopening this needs three things first: escaping, length and shape
 * validation in src/lib/db.ts (owned by the backend agent), and a way to
 * remove a message.
 */
---
<BaseLayout
  title="Guestbook"
  description="สมุดเยี่ยมยังไม่เปิดใช้งาน"
>
  <section class="card">
    <h1>Guestbook</h1>
    <p>สมุดเยี่ยมยังไม่เปิดใช้งาน</p>
    <p>ถ้าอยากติดต่อเรื่องงานหรือมีคำถาม ส่งผ่าน <a href="/contact">ฟอร์มติดต่อ</a> ได้เลย</p>
  </section>
</BaseLayout>
