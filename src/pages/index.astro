---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadProfile } from '../lib/profile';
const profile = loadProfile();
// The first paragraph carries the "who is this, what can they be hired for"
// answer (D11). The rest lives on About so the home page stays scannable.
const [opening] = profile.bio.split(/\n{2,}/);
// profile.audience is deliberately not rendered — it is an internal note (D4).
---
<BaseLayout title={`${profile.name} · เขียนโค้ดและออกแบบระบบ`} description={profile.headline}>
  <section class="card">
    <p class="eyebrow">{profile.name}</p>
    <h1>{profile.headline}</h1>
    <p class="lede">{opening}</p>
    <p><a href="/contact">ติดต่อเรื่องงาน →</a></p>
  </section>
  <section class="grid">
    <a class="card" href="/about"><h2>About</h2><p>วิธีทำงานและสิ่งที่ให้เวลามากที่สุดตอนนี้</p></a>
    <a class="card" href="/interests"><h2>Interests</h2><p>หัวข้อที่ทำได้จริงและทำบ่อย</p></a>
    <a class="card" href="/contact"><h2>Contact</h2><p>ส่งรายละเอียดงานเข้ามาได้ที่ฟอร์ม</p></a>
  </section>
</BaseLayout>
