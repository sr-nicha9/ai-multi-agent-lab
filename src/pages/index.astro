---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadProfile } from '../lib/profile';
const profile = loadProfile();

// Bio is multi-paragraph in docs/PROFILE.md. Split on blank lines so each
// paragraph renders as its own <p>; the home page shows the opening paragraph
// only and sends the rest to /about (see D11 — home stays short, one CTA).
const bioParagraphs = profile.bio
  .split(/\n{2,}/)
  .map((p) => p.trim())
  .filter(Boolean);
const intro = bioParagraphs.slice(0, 1);
const hasMoreBio = bioParagraphs.length > intro.length;
---
<BaseLayout title={`${profile.name} · Home`} description={profile.headline}>
  <section class="card">
    <p style="margin:0;color:var(--accent);font-weight:700">Personal branding site</p>
    <h1>{profile.name}</h1>
    <p style="font-size:1.2rem;color:var(--text)">{profile.headline}</p>
    {intro.map((p) => <p>{p}</p>)}
    {hasMoreBio && <p><a href="/about">อ่านเรื่องราวทั้งหมดในหน้า About</a></p>}
  </section>
  <section class="grid">
    <a class="card" href="/about"><h2>About</h2><p>เรื่องราวและเส้นทาง</p></a>
    <a class="card" href="/interests"><h2>Interests</h2><p>หัวข้อที่สนใจ</p></a>
    <a class="card" href="/contact" style="border-color:var(--accent);font-weight:600">
      <h2>Contact</h2><p>ส่งข้อความถึงฉันผ่านฟอร์ม</p>
    </a>
  </section>
</BaseLayout>
